NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret__your_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
RESEND_API_KEY=re_your_api_key
LEAD_ALERT_TO=you@example.com
LEAD_ALERT_FROM=AJM Reals <onboarding@resend.dev>
NEXT_PUBLIC_SITE_URL=https://your-site.up.railway.app

# Optional — Cloudflare Turnstile. Forms work without these; set BOTH to turn
# bot verification on. Setting only the secret blocks every submission.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared secret for the follow-up cron endpoint. Generate a long random
# string; the scheduler sends it as "Authorization: Bearer <value>".
CRON_SECRET=

# Google Analytics 4 measurement ID. Omit to disable analytics.
NEXT_PUBLIC_GA_ID=
